{
  "name": "Fortress TEST",
  "deckBuilding": {
    "mainFilters": ["type", "cost"],
    "formats": [
      { "title": "Standard format", "gameplay": "Standard" }
    ]
  },
  "gameplay": {
    "Standard": {
      "mulligan": { 
        "startingHandSize": 5,
        "mulliganCount": { "max": 5 },
        "mulliganCycle": {
          "info": "First mulligan is free: redraw all 5. Each mulligan after that costs 1 card from your starting hand.",
          "steps": ["toBottom", "shuffle", "draw"],
          "selectionRange": {"max": 0}
        }
      },
      "newTurn": { 
        "drawPerTurn": 0
      },
      "countersStartingValues": [8, 12],
      "sections": {
        "layout": {
          "direction": "row",
          "content": [{"direction": "column", 
                        "style": {"width": "45vh"},
                        "content": [
                                    {"section": "fortress"},
                                    {"direction": "row", 
                                      "content": [
                                                  {"section": "spoiled"},
                                                  {"section": "reserves"}
                                                ]
                                    }
                                  ]                             
                      },
                      {"direction": "column", 
                      "content": [{"section": "traps"},
                                  {"section": "minions"}
                                  ]
                      }
                    ]
        },
        "sectionsDict": {
          "fortress": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER"},
          "spoiled": { "isHidden": "yes", "height": "SMALL", "alignment": "CENTER"},
          "reserves": { "isHidden": "no", "height": "MEDIUM", "alignment": "CENTER"},
          "traps": { "isHidden": "yes", "height": "MEDIUM", "alignment": "CENTER"},
          "minions": { "isHidden": "no", "height": "MEDIUM", "alignment": "CENTER"}
        }
      }
    }
  },
  "cards": {
    "dataUrl": "https://axeium.github.io/tcg-arena-testing/cards.json",
    "cardBack": "https://axeium.github.io/tcg-arena-testing/CARD_IMAGES/cardback.png"
  }
}
