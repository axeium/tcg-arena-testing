{
  "name": "Fortress TEST",
  "menuBackgroundImage": "https://i.postimg.cc/yY2Q0nYc/Background-Less.jpg",
  "defaultRessources": ["https://i.postimg.cc/yY2Q0nYc/Background-Less.jpg", "https://i.postimg.cc/Gh67vzhk/Background-More.jpg"],
  "deckBuilding": {
    "mainFilters": ["class", "type", "cost"],
    "formats": [
      { "title": "Standard format", "gameplay": "Standard" }
    ]
  },
  "gameplay": {
    "Standard": {
      "mulligan": { 
        "startingHandSize": 5,
        "mulliganCount": { "max": 5},
        "mulliganCycle": {
          "info": "First mulligan is free: redraw all 5. Each mulligan after that costs 1 card from your starting hand.",
          "steps": ["toBottom", "shuffle", "draw", "applyPenalty"],
          "selectionRange": {"min": 6, "max": 6}
        }
      },
      "newTurn": { 
        "drawPerTurn": 0
      },
      "countersStartingValues": [8, 12],
      "sections": {
        "layout": {
          "direction": "row",
          "content": [{"direction": "column", "style": {"width": "30vw"},
                        "content": [
                                    {"section": "fortress"},
                                    {"direction": "row", 
                                      "content": [
                                                  {"section": "spoiled"},
                                                  {"section": "reserves"}
                                                ]
                                    }
                                  ]                             
                      },
                      {"direction": "column", 
                       "content": [{"section": "traps"},
                                  {"section": "minions"}
                                  ]
                      }
                    ]
        },
        "sectionsDict": {
          "fortress": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER"},
          "spoiled": { "isHidden": "yes", "height": "SMALL", "alignment": "CENTER"},
          "reserves": { "isHidden": "no", "height": "MEDIUM", "alignment": "CENTER"},
          "traps": { "isHidden": "yes", "height": "MEDIUM", "alignment": "CENTER"},
          "minions": { "isHidden": "no", "height": "MEDIUM", "alignment": "CENTER"}
        }
      }
    },
    "draggableTokens": [
                        {"id": "Shield", "name": "Shield", "image": "https://raw.githubusercontent.com/axeium/tcg-arena-testing/refs/heads/main/CARD_IMAGES/shield.png"}
                        ]
  },
  "cards": {
    "dataUrl": "https://axeium.github.io/tcg-arena-testing/fortress_cards.json",
    "cardBack": "https://i.postimg.cc/MH5wvNSJ/Fortress-Card-Back.png"
  }
}
